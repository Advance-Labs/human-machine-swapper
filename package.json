{
  "name": "human-machine-swapper",
  "version": "1.0.2",
  "description": "A web component that adds a Human / Machine pill to any website. Machine shows the site's llms.txt, the plain-text reading written for language models, rendered in place. One file, about 6 KB gzipped, no dependencies and no build step.",
  "keywords": [
    "llms.txt",
    "llmstxt",
    "web-component",
    "custom-element",
    "aeo",
    "geo",
    "answer-engine-optimization",
    "ai-search",
    "machine-readable",
    "toggle",
    "switcher",
    "agent",
    "llm"
  ],
  "homepage": "https://advancelabs.dev/human-machine-swapper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Advance-Labs/human-machine-swapper.git"
  },
  "bugs": {
    "url": "https://github.com/Advance-Labs/human-machine-swapper/issues"
  },
  "license": "Apache-2.0",
  "author": "Advance Labs Inc. (https://advancelabs.dev)",
  "type": "module",
  "main": "src/human-machine-swapper.js",
  "module": "src/human-machine-swapper.js",
  "unpkg": "src/human-machine-swapper.js",
  "jsdelivr": "src/human-machine-swapper.js",
  "exports": {
    ".": "./src/human-machine-swapper.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "llms.txt",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
